diff --git a/adapter/provider/healthcheck.go b/adapter/provider/healthcheck.go
index 822a00d5..bf112ef7 100644
--- a/adapter/provider/healthcheck.go
+++ b/adapter/provider/healthcheck.go
@@ -21,6 +21,22 @@ type HealthCheckOption struct {
 	Interval uint
 }
 
+var autoHealthChecksGate sync.RWMutex
+
+// 自动测速等待配置与规则加载完成，手动测速保持即时执行。
+func PauseAutoHealthChecks() func() {
+	autoHealthChecksGate.Lock()
+	return autoHealthChecksGate.Unlock
+}
+
+func (hc *HealthCheck) autoCheck() {
+	autoHealthChecksGate.RLock()
+	autoHealthChecksGate.RUnlock()
+	if hc.ctx.Err() == nil {
+		hc.check()
+	}
+}
+
 type extraOption struct {
 	expectedStatus utils.IntRanges[uint16]
 	filters        map[string]struct{}
@@ -43,14 +59,14 @@ type HealthCheck struct {
 
 func (hc *HealthCheck) process() {
 	ticker := time.NewTicker(hc.interval)
-	go hc.check()
+	go hc.autoCheck()
 	for {
 		select {
 		case <-ticker.C:
 			lastTouch := hc.lastTouch.Load()
 			since := time.Since(lastTouch)
 			if !hc.lazy || since < hc.interval {
-				hc.check()
+				hc.autoCheck()
 			} else {
 				log.Debugln("Skip once health check because we are lazy")
 			}
