+// 仅加速独立列表头下的简单 ASCII 标量；转义、标签、别名与复杂语法交给 YAML 解析器。
+func simpleYAMLRule(line []byte) (string, bool) {
+	line = bytes.Trim(line, " \r\n")
+	if len(line) < 3 || line[0] != '-' || line[1] != ' ' {
+		return "", false
+	}
+	value := bytes.Trim(line[2:], " ")
+	if len(value) == 0 {
+		return "", false
+	}
+	quote := value[0]
+	if quote == '\'' || quote == '"' {
+		if len(value) < 2 || value[len(value)-1] != quote {
+			return "", false
+		}
+		value = value[1 : len(value)-1]
+		for _, ch := range value {
+			if ch < 0x20 || ch > 0x7e || ch == quote || (quote == '"' && ch == '\\') {
+				return "", false
+			}
+		}
+		return string(value), true
+	}
+	if value[0] == ',' || bytes.Equal(value, []byte("-")) || value[len(value)-1] == ':' || bytes.Equal(value, []byte("null")) || bytes.Equal(value, []byte("Null")) || bytes.Equal(value, []byte("NULL")) {
+		return "", false
+	}
+	for _, ch := range value {
+		if ch >= 'a' && ch <= 'z' || ch >= 'A' && ch <= 'Z' || ch >= '0' && ch <= '9' {
+			continue
+		}
+		switch ch {
+		case '.', '-', '_', '+', '/', ':', ',':
+		default:
+			return "", false
+		}
+	}
+	return string(value), true
+}
