+// 常见 ASCII 域名直接校验并反转；复杂通配符与 Unicode 保留完整语法校验。
+func simpleDomainKey(domain string) (key string, exact, ok bool) {
+	start := 0
+	if strings.HasPrefix(domain, "+.") {
+		start = 2
+		exact = true
+	} else if strings.HasPrefix(domain, ".") {
+		start = 1
+	}
+	if len(domain) <= start || domain[len(domain)-1] == '.' {
+		return "", false, false
+	}
+	dot := true
+	for i := start; i < len(domain); i++ {
+		c := domain[i]
+		if c == '.' {
+			if dot {
+				return "", false, false
+			}
+			dot = true
+			continue
+		}
+		if !(c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c >= '0' && c <= '9' || c == '-' || c == '_') {
+			return "", false, false
+		}
+		dot = false
+	}
+	var reversed strings.Builder
+	reversed.Grow(len(domain) + 1)
+	for i := len(domain) - 1; i >= 0; i-- {
+		c := domain[i]
+		if c >= 'A' && c <= 'Z' {
+			c += 'a' - 'A'
+		}
+		reversed.WriteByte(c)
+	}
+	if start == 1 {
+		reversed.WriteByte('+')
+	}
+	return reversed.String(), exact, true
+}
