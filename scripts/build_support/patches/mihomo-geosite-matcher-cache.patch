+// 完整数据内容与筛选条件共同取键，命中后直接恢复匹配器，跳过原始域名列表的解码。
+func geoSiteMatcherCacheKey(name string) ([sha256.Size]byte, bool) {
+	var key [sha256.Size]byte
+	if geoSiteMatcher != "succinct" || !router.DomainMatcherCacheEnabled() {
+		return key, false
+	}
+	file, err := os.Open(C.Path.GeoSite())
+	if err != nil {
+		return key, false
+	}
+	defer file.Close()
+	hash := sha256.New()
+	if _, err := io.Copy(hash, file); err != nil {
+		return key, false
+	}
+	hash.Write([]byte("\x00" + geoLoaderName + "\x00" + name))
+	copy(key[:], hash.Sum(nil))
+	return key, true
+}
