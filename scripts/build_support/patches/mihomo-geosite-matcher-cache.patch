+var domainMatcherCacheDir string
+var domainMatcherCacheMagic = [4]byte{'S', 'M', 'C', 2}
+
+const domainMatcherCacheHeader = 4 + 2*sha256.Size
+const domainMatcherCacheBudget = 16 * 1024 * 1024
+
+func SetDomainMatcherCacheDir(dir string) {
+	domainMatcherCacheDir = dir
+}
+
+// 按筛选后的域名类型与内容取键，属性筛选和地理数据更新自然生成新缓存。
+func domainMatcherCacheKey(domains []*Domain) (string, [sha256.Size]byte) {
+	if domainMatcherCacheDir == "" || len(domains) < 1024 {
+		return "", [sha256.Size]byte{}
+	}
+	hash := sha256.New()
+	var header [8]byte
+	for _, domain := range domains {
+		binary.BigEndian.PutUint32(header[:4], uint32(domain.Type))
+		binary.BigEndian.PutUint32(header[4:], uint32(len(domain.Value)))
+		hash.Write(header[:])
+		hash.Write(utils.ImmutableBytesFromString(domain.Value))
+	}
+	var sourceHash [sha256.Size]byte
+	copy(sourceHash[:], hash.Sum(nil))
+	return filepath.Join(domainMatcherCacheDir, fmt.Sprintf("%x.matcher", sourceHash)), sourceHash
+}
+
+func readDomainMatcherCache(path string, sourceHash [sha256.Size]byte) *succinctDomainMatcher {
+	if path == "" {
+		return nil
+	}
+	cache, err := os.ReadFile(path)
+	if err != nil || len(cache) <= domainMatcherCacheHeader {
+		return nil
+	}
+	data := cache[domainMatcherCacheHeader:]
+	dataHash := sha256.Sum256(data)
+	if !bytes.Equal(cache[:4], domainMatcherCacheMagic[:]) ||
+		!bytes.Equal(cache[4:4+sha256.Size], sourceHash[:]) ||
+		!bytes.Equal(cache[4+sha256.Size:domainMatcherCacheHeader], dataHash[:]) {
+		return nil
+	}
+	if len(data) < 4 {
+		return nil
+	}
+	metadataSize := int(binary.BigEndian.Uint32(data[:4]))
+	if metadataSize > len(data)-4 {
+		return nil
+	}
+	var metadata domainMatcherMetadata
+	if err := json.Unmarshal(data[4:4+metadataSize], &metadata); err != nil || metadata.Count < 1 {
+		return nil
+	}
+	set, err := trie.ReadDomainSetBin(bytes.NewReader(data[4+metadataSize:]))
+	if err != nil {
+		return nil
+	}
+	matcher := &succinctDomainMatcher{set: set, count: metadata.Count, otherPatterns: metadata.Patterns}
+	for _, pattern := range metadata.Patterns {
+		kind, exists := matcherTypeMap[pattern.Type]
+		if !exists || (pattern.Type != Domain_Plain && pattern.Type != Domain_Regex) {
+			return nil
+		}
+		other, err := kind.New(pattern.Value)
+		if err != nil {
+			return nil
+		}
+		matcher.otherMatchers = append(matcher.otherMatchers, other)
+	}
+	return matcher
+}
+
+func writeDomainMatcherCache(path string, sourceHash [sha256.Size]byte, matcher *succinctDomainMatcher) error {
+	var buffer bytes.Buffer
+	buffer.Write(domainMatcherCacheMagic[:])
+	buffer.Write(sourceHash[:])
+	buffer.Write(make([]byte, sha256.Size))
+	metadata, err := json.Marshal(domainMatcherMetadata{Count: matcher.count, Patterns: matcher.otherPatterns})
+	if err != nil {
+		return err
+	}
+	if err := binary.Write(&buffer, binary.BigEndian, uint32(len(metadata))); err != nil {
+		return err
+	}
+	buffer.Write(metadata)
+	if err := matcher.set.WriteBin(&buffer); err != nil {
+		return err
+	}
+	data := buffer.Bytes()
+	if len(data) > domainMatcherCacheBudget {
+		return fmt.Errorf("domain matcher cache exceeds %d bytes", domainMatcherCacheBudget)
+	}
+	dataHash := sha256.Sum256(data[domainMatcherCacheHeader:])
+	copy(data[4+sha256.Size:domainMatcherCacheHeader], dataHash[:])
+	dir := filepath.Dir(path)
+	if err := os.MkdirAll(dir, 0770); err != nil {
+		return err
+	}
+	info, err := os.Stat(dir)
+	if err != nil {
+		return err
+	}
+	if info.Mode().Perm() != 0770 {
+		if err := os.Chmod(dir, 0770); err != nil {
+			return err
+		}
+	}
+	tmp, err := os.CreateTemp(dir, ".domain-matcher-*")
+	if err != nil {
+		return err
+	}
+	defer os.Remove(tmp.Name())
+	if _, err := tmp.Write(data); err != nil {
+		tmp.Close()
+		return err
+	}
+	if err := tmp.Chmod(0640); err != nil {
+		tmp.Close()
+		return err
+	}
+	if err := tmp.Close(); err != nil {
+		return err
+	}
+	if err := os.Rename(tmp.Name(), path); err != nil {
+		return err
+	}
+	pruneDomainMatcherCache(dir, path)
+	return nil
+}
+
+func pruneDomainMatcherCache(dir, keep string) {
+	type entry struct {
+		path string
+		info os.FileInfo
+	}
+	items, err := os.ReadDir(dir)
+	if err != nil {
+		return
+	}
+	var files []entry
+	var total int64
+	for _, item := range items {
+		if item.IsDir() || !strings.HasSuffix(item.Name(), ".matcher") {
+			continue
+		}
+		info, err := item.Info()
+		if err == nil {
+			total += info.Size()
+			files = append(files, entry{filepath.Join(dir, item.Name()), info})
+		}
+	}
+	sort.Slice(files, func(i, j int) bool { return files[i].info.ModTime().Before(files[j].info.ModTime()) })
+	for _, file := range files {
+		if total <= domainMatcherCacheBudget {
+			break
+		}
+		if file.path != keep && os.Remove(file.path) == nil {
+			total -= file.info.Size()
+		}
+	}
+}
